APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
DEEPSEEK_API_KEY=replace-with-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=server-name\instance-name
DB_DATABASE=RecruitAI
DB_TRUSTED_CONNECTION=true
RESUME_ROOT=C:\Zhaopin\Resume
RESUME_TEMP_ROOT=C:\Zhaopin\ResumeTemp
WORKER_ENABLED=true
WORKER_ID=agent-production-1
WORKER_POLL_SECONDS=5
WORKER_LEASE_MINUTES=10
WORKER_CONCURRENCY=10
RESUME_TARGET_FILE_BYTES=20971520
RESUME_HARD_SOURCE_FILE_BYTES=524288000
RESUME_JSON_MAX_FILE_BYTES=10485760
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=5000
RAG_EMBEDDING_MODEL=hashing-char-ngram-v1
RAG_EMBEDDING_DIMENSION=1024
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=160
