{
  "LoginUrl": "https://ehire.51job.com/",
  "TalentSearchUrl": "https://ehire.51job.com/Revision/talent/search?rt=1786244528973",
  "TalentManagementUrl": "https://ehire.51job.com/Revision/talent/management",
  "Authentication": {
    "CookieUrl": "https://ehire.51job.com/",
    "RequiredCookieNames": [],
    "CookieNameHints": ["auth", "token", "session", "sso", "ticket", "login", "user"]
  },
  "Download": {
    "MinimumPerRun": 50,
    "MaximumPerRun": 100,
    "DefaultPerRun": 100,
    "MaxPagesPerRun": 20,
    "DetailOpenDelayMilliseconds": 650,
    "ListRestoreDelayMilliseconds": 500,
    "PageChangeDelayMilliseconds": 650,
    "LoadMoreBatchSize": 50,
    "LoadMoreDelayMilliseconds": 1500,
    "DiscardFailures": true
  },
  "ServerUpload": {
    "ApiUrl": "https://hr.siekon.com/api/third-party-resumes",
    "ApiKey": "CHANGE_ME",
    "TimeoutSeconds": 60,
    "MaximumFilesPerRun": 100
  },
  "NetworkCapture": {
    "Enabled": true,
    "ClearAfterSuccessfulUpload": true,
    "MaximumBodyBytes": 4194304,
    "AllowedHosts": ["51job.com"],
    "UrlKeywords": ["talent", "resume", "search", "candidate", "recommend", "job"]
  },
  "Search": {
    "ClearExistingFilters": true,
    "ExcludeViewedCandidates": true,
    "InteractionDelayMilliseconds": 1000,
    "Filters": [
      {
        "ControlName": "求职状态",
        "Options": ["离职-周内到岗"],
        "ConfirmButtonText": null
      },
      {
        "ControlName": "从事行业",
        "Options": ["汽车零部件", "汽车研发/制造"],
        "UseDialogSearch": true,
        "ConfirmButtonText": "确定"
      },
      {
        "ControlName": "最近活跃时间",
        "ControlAliases": ["近1年", "近1周"],
        "Options": ["近1周"],
        "OpenMoreFilters": true,
        "ConfirmButtonText": "确定"
      },
      {
        "ControlName": "跳槽次数",
        "Options": ["5年内跳槽次数<3次"],
        "OpenMoreFilters": true,
        "ConfirmButtonText": "确定"
      }
    ]
  }
}
