@{ ViewData["Title"]="知识库管理"; }
<div class="page-head"><div><h1>公共知识库</h1><p>这里维护公司、行业、技术和人才评价等公共知识。岗位画像已移入“岗位管理”，由具体岗位统一维护。</p></div><button id="new">新增知识</button></div>
<form id="filter" class="panel"><label>分类<select id="filter-type"><option value="">全部</option><option value="COMPANY_INFO">公司信息</option><option value="INDUSTRY_INFO">行业信息</option><option value="TECH_STANDARD">技术标准</option><option value="TALENT_STANDARD">人才标准</option><option value="SCORE_RULE">评分规则</option><option value="OTHER">其他</option></select></label><label>关键字<input id="keyword"></label><button>查询</button></form>
<div id="message" class="notice" hidden></div><div id="documents"></div>
<dialog id="editor" class="knowledge-dialog"><form id="edit-form" method="dialog"><div class="dialog-head"><h2 id="editor-title">知识维护</h2><button class="dialog-close" type="button" onclick="closeEditor()">×</button></div><div id="editor-message" class="notice" hidden></div><div class="knowledge-form"><label>知识编码<input name="code" required maxlength="100" placeholder="例如 COMPANY-001"></label><label>分类<select name="documentType"><option value="COMPANY_INFO">公司信息</option><option value="INDUSTRY_INFO">行业信息</option><option value="TECH_STANDARD">技术标准</option><option value="TALENT_STANDARD">人才标准</option><option value="SCORE_RULE">评分规则</option><option value="OTHER">其他</option></select></label><label class="wide">标题<input name="title" required maxlength="300"></label><label class="wide">知识内容<textarea name="content" required maxlength="50000"></textarea></label><label class="wide">AI补充要求（可选）<input id="ai-instruction" maxlength="1000" placeholder="例如：补充公司性质、行业、主要产品，并标记不确定内容"></label></div><div class="dialog-actions"><button id="ai-draft" type="button" class="secondary">AI完善草稿</button><button id="save-draft" type="button">保存为草稿</button><button type="button" class="secondary" onclick="closeEditor()">取消</button></div></form></dialog>
@section Scripts{<script>
let current=null,loading=false,refreshTimer=null;const msg=document.getElementById('message'),editorMsg=document.getElementById('editor-message');const types={JOB_REQUIREMENT:'岗位要求',COMPANY_INFO:'公司信息',INDUSTRY_INFO:'行业信息',TECH_STANDARD:'技术标准',TALENT_STANDARD:'人才标准',SCORE_RULE:'评分规则',OTHER:'其他'};function h(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}function show(v){msg.textContent=v;msg.hidden=false}function showEditor(v){editorMsg.textContent=v;editorMsg.hidden=false}function clearEditorMessage(){editorMsg.textContent='';editorMsg.hidden=true}
async function load(silent=false){if(loading)return;loading=true;try{const type=encodeURIComponent(document.getElementById('filter-type').value),keyword=encodeURIComponent(document.getElementById('keyword').value);const rows=await api(`/api/knowledge-documents?type=${type}&keyword=${keyword}`);document.getElementById('documents').innerHTML=rows.map(x=>`<article class="knowledge-row"><span>${types[x.documentType]||x.documentType}</span><strong>${h(x.title)}</strong><span>${x.status} · V${x.version}</span><p>${h(x.content.length>240?x.content.slice(0,240)+'…':x.content)}</p><div class="actions"><button onclick="edit(${x.id})">编辑</button><button class="secondary" onclick="publishDoc(${x.id})">发布/RAG重建</button><button class="danger" onclick="archiveDoc(${x.id})">归档</button></div></article>`).join('')||'<p>暂无知识。</p>';scheduleRefresh(rows.some(x=>x.status==='INDEXING')?1000:5000)}catch(x){if(!silent)show(x.message);scheduleRefresh(5000)}finally{loading=false}}
function scheduleRefresh(delay){clearTimeout(refreshTimer);refreshTimer=setTimeout(()=>{if(document.visibilityState==='visible'&&!document.getElementById('editor').open)load(true);else scheduleRefresh(2000)},delay)}
function openEditor(x){current=x||null;const f=document.getElementById('edit-form');f.reset();clearEditorMessage();if(x)for(const k of ['code','title','documentType','content'])f.elements[k].value=x[k]||'';document.getElementById('editor-title').textContent=x?'编辑知识':'新增知识';document.getElementById('editor').showModal()}function closeEditor(){document.getElementById('editor').close();clearEditorMessage()}async function edit(id){openEditor(await api('/api/knowledge-documents/'+id))}
document.getElementById('new').onclick=()=>openEditor(null);document.getElementById('filter').onsubmit=e=>{e.preventDefault();load().catch(x=>show(x.message))};
document.getElementById('ai-draft').onclick=async()=>{const f=document.getElementById('edit-form'),button=document.getElementById('ai-draft');button.disabled=true;clearEditorMessage();showEditor('AI正在完善草稿，请稍候…');try{const r=await api('/api/knowledge-documents/ai-draft',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:f.elements.title.value,documentType:f.elements.documentType.value,content:f.elements.content.value,instruction:document.getElementById('ai-instruction').value})});f.elements.content.value=r.content;showEditor('AI草稿已生成，请HR核对和修改后保存。')}catch(x){showEditor(x.message)}finally{button.disabled=false}};
document.getElementById('save-draft').onclick=async()=>{const f=document.getElementById('edit-form'),body={code:f.elements.code.value,title:f.elements.title.value,documentType:f.elements.documentType.value,content:f.elements.content.value,rowVersion:current?.rowVersion||null};try{if(current)await api(`/api/knowledge-documents/${current.id}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});else await api('/api/knowledge-documents',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});closeEditor();show('知识草稿已保存。');await load()}catch(x){showEditor(x.message)}};
async function publishDoc(id){if(!confirm('确认发布并更新AI知识？'))return;try{await api(`/api/knowledge-documents/${id}/publish`,{method:'POST'});show('发布请求已提交；索引完成后状态自动变为 ACTIVE。');await load();scheduleRefresh(500)}catch(x){show(x.message)}}async function archiveDoc(id){if(!confirm('确认停用该知识？'))return;try{await api(`/api/knowledge-documents/${id}/archive`,{method:'POST'});await load()}catch(x){show(x.message)}}document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')scheduleRefresh(100)});load().catch(x=>show(x.message));
</script>}
