@{ ViewData["Title"]="简历收藏"; ViewData["MainClass"]="page-wide"; }
<div class="page-head"><div><h1>简历收藏</h1><p>AI语音面试候选人从本页单独发起；候选人必须已有岗位评分结果和手机号码。</p></div><a class="button secondary" href="/interviews">面试管理</a></div>
<div id="message" class="notice" hidden></div>
<div class="favorites-filter-bar"><label><span>岗位筛选</span><select id="job-filter"><option value="">全部岗位</option></select></label></div>
<div class="ranking-table-wrap"><table class="favorites-table"><thead><tr><th>岗位排名</th><th>候选人</th><th>岗位</th><th>总分</th><th>技能</th><th>项目</th><th>经验/行业</th><th>学历</th><th>当前公司</th><th>建议</th><th>评分版本</th><th>收藏时间</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div>
<div class="actions pager"><button id="previous" class="secondary" type="button">上一页</button><span id="page-info" class="muted"></span><button id="next" class="secondary" type="button">下一页</button></div>
@section Scripts{<script>
const msg=document.getElementById('message');let page=1;function show(v){msg.textContent=v;msg.hidden=false}function h(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}
async function loadJobs(){const jobs=await api('/api/jobs?page=1&pageSize=100');document.getElementById('job-filter').insertAdjacentHTML('beforeend',jobs.map(x=>`<option value="${x.id}">${h(x.name)}</option>`).join(''))}
async function load(){const jobId=document.getElementById('job-filter').value;const x=await api(`/api/candidate-jobs/favorites?page=${page}&pageSize=20${jobId?`&jobId=${jobId}`:''}`);page=x.page;document.getElementById('rows').innerHTML=x.items.map(r=>`<tr><td><strong>#${r.rank}</strong></td><td><a href="/candidates/${r.candidateId}">${h(r.candidateName)}</a>${r.hasPhone?'':'<br><span class="error">缺少手机号</span>'}</td><td><a href="/jobs/${r.jobId}">${h(r.jobName)}</a></td><td><strong>${r.aiScore??'-'}</strong></td><td>${r.skillScore??'-'}</td><td>${r.projectScore??'-'}</td><td>${r.experienceScore??'-'}</td><td>${r.educationScore??'-'}</td><td>${h(r.currentCompany||'-')}</td><td>${h(r.recommendation||'-')}</td><td>${r.scoreConfigVersion?'V'+r.scoreConfigVersion:'-'}</td><td>${new Date(r.favoriteTime+'Z').toLocaleString()}</td><td><div class="actions">${r.activeQuestionSetId?`<a class="button" href="/interviews/question-sets/${r.activeQuestionSetId}">审议题集</a>`:`<button type="button" onclick="startInterview(${r.candidateJobId},this)" ${!r.hasPhone?'disabled':''}>${r.hasPhone?'AI创建题集':'需补手机号'}</button>`}<button type="button" class="danger" onclick="removeFavorite(${r.candidateJobId})">取消收藏</button></div></td></tr>`).join('')||'<tr><td colspan="13">当前岗位暂无收藏简历。</td></tr>';const pages=Math.max(1,Math.ceil(x.totalCount/x.pageSize));document.getElementById('page-info').textContent=`第 ${x.page}/${pages} 页，共 ${x.totalCount} 条收藏`;document.getElementById('previous').disabled=x.page<=1;document.getElementById('next').disabled=x.page>=pages}
async function startInterview(candidateJobId,button){button.disabled=true;button.textContent='AI创建中…';show('AI正在结合候选人评分建议和已启用岗位方案创建题集，请稍候。');try{const result=await api('/api/interviews/question-sets',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({candidateJobId,planId:0})});location.href='/interviews/question-sets/'+result.id}catch(x){show(x.message);button.disabled=false;button.textContent='AI创建题集'}}
async function removeFavorite(id){if(!confirm('确认取消这条岗位简历收藏吗？'))return;try{await api(`/api/candidate-jobs/${id}/unfavorite`,{method:'POST'});show('已取消收藏。');await load()}catch(x){show(x.message)}}
document.getElementById('job-filter').onchange=()=>{page=1;load().catch(x=>show(x.message))};document.getElementById('previous').onclick=()=>{if(page>1){page--;load()}};document.getElementById('next').onclick=()=>{page++;load()};loadJobs().then(load).catch(x=>show(x.message));
</script>}
