@{ ViewData["Title"]="评分管理"; ViewData["MainClass"]="page-wide"; }
<div class="page-head"><div><h1>岗位评分管理</h1><p>评分参数可反复修改；每次启动都会生成独立排行，并保留当次参数、岗位画像和评分结果。</p></div></div>
<div class="panel"><label>岗位筛选<select id="job-filter"><option value="">全部岗位</option></select></label></div>
<div id="message" class="notice" hidden></div><div id="scores"></div>
<dialog id="ranking" class="knowledge-dialog score-ranking-dialog">
  <div class="dialog-head"><h2 id="ranking-title">岗位评分排行</h2><button class="dialog-close" onclick="closeRanking()">×</button></div>
  <div class="ranking-history-bar"><label>评分批次<select id="ranking-run"></select></label><div class="ranking-date-filter"><label>简历导入日期<input id="ranking-resume-from" type="date" aria-label="简历导入开始日期"></label><span>至</span><label><span class="visually-hidden">简历导入结束日期</span><input id="ranking-resume-to" type="date" aria-label="简历导入结束日期"></label><label>51JOB人才ID<input id="ranking-talent-id" type="text" inputmode="numeric" maxlength="100" placeholder="请输入人才ID"></label><button id="ranking-query" type="button">查询</button><button id="ranking-clear-date" type="button" class="secondary">清空</button></div><span id="ranking-state" class="muted"></span></div>
  <div id="ranking-params" class="ranking-params"></div>
  <div class="ranking-table-wrap"><table><colgroup><col class="rank-col"><col class="candidate-col"><col class="date-col"><col class="score-col"><col class="score-col"><col class="score-col"><col class="experience-col"><col class="score-col"><col class="company-col"><col class="recommendation-col"><col class="favorite-col"></colgroup><thead><tr><th>排名</th><th>候选人</th><th>简历导入日期</th><th>总分</th><th>技能</th><th>项目</th><th>经验/行业</th><th>学历</th><th>当前公司</th><th>建议</th><th class="favorite-cell">收藏操作</th></tr></thead><tbody id="ranking-rows"></tbody></table></div>
  <div class="actions ranking-actions"><button id="ranking-prev" class="secondary">上一页</button><span id="ranking-page"></span><button id="ranking-next" class="secondary">下一页</button></div>
</dialog>
@section Scripts{<script>
const msg=document.getElementById('message');let rankingJob=0,rankingName='',rankingRunId=0,rankingPage=1,rankingTimer=null,scoreJobs=[];
function show(v){msg.textContent=v;msg.hidden=false}
function h(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML}
function score(v){return v===null||v===undefined?'-':v}
async function load(){const filter=document.getElementById('job-filter'),selected=filter.value;scoreJobs=await api('/api/jobs?pageSize=100');filter.innerHTML='<option value="">全部岗位</option>'+scoreJobs.map(x=>`<option value="${x.id}">${h(x.name)}</option>`).join('');filter.value=selected;renderScores()}
function renderScores(){const selected=Number(document.getElementById('job-filter').value||0),rows=selected?scoreJobs.filter(x=>x.id===selected):scoreJobs;document.getElementById('scores').innerHTML=rows.map(x=>`<form class="score-card" data-id="${x.id}" data-version="${x.rowVersion}"><div class="score-title"><strong>${h(x.name)}</strong><span>V${x.scoreConfigVersion} · ${x.resumeCount}份关联简历</span><button type="button" onclick="queueScore(${x.id},'${h(x.name)}')">启动新一轮评分</button><button type="button" class="secondary" onclick="openRanking(${x.id},'${h(x.name)}')">查看最新排行</button><button type="button" class="secondary" onclick="openRanking(${x.id},'${h(x.name)}',true)">历史排行</button></div><div class="score-row"><label>技能<input name="skillWeight" type="number" min="0" max="100" value="${x.skillWeight}"></label><label>项目<input name="projectWeight" type="number" min="0" max="100" value="${x.projectWeight}"></label><label>工作经验与行业背景<input name="experienceWeight" type="number" min="0" max="100" value="${x.experienceWeight}"></label><label>学历<input name="educationWeight" type="number" min="0" max="100" value="${x.educationWeight}"></label><span class="main-total">一级合计100</span></div><details><summary>经验内部权重</summary><div class="score-row"><label>实际职责<input name="dutyWeight" type="number" min="0" max="100" value="${x.dutyWeight}"></label><label>公司产品<input name="productWeight" type="number" min="0" max="100" value="${x.productWeight}"></label><label>所属行业<input name="industryWeight" type="number" min="0" max="100" value="${x.industryWeight}"></label><label>工作年限<input name="tenureWeight" type="number" min="0" max="100" value="${x.tenureWeight}"></label><label>公司性质/研发环境<input name="companyEnvironmentWeight" type="number" min="0" max="100" value="${x.companyEnvironmentWeight}"></label><span class="sub-total">经验合计100</span></div></details><button>保存新版本</button></form>`).join('')||'<div class="empty-state">未找到该岗位。</div>';document.querySelectorAll('.score-card').forEach(f=>{f.oninput=()=>totals(f);f.onsubmit=save;totals(f)})}
function totals(f){const sum=keys=>keys.reduce((s,k)=>s+Number(f.elements[k].value||0),0);const main=sum(['skillWeight','projectWeight','experienceWeight','educationWeight']),sub=sum(['dutyWeight','productWeight','industryWeight','tenureWeight','companyEnvironmentWeight']);const a=f.querySelector('.main-total'),b=f.querySelector('.sub-total');a.textContent=`一级合计 ${main}`;b.textContent=`经验合计 ${sub}`;a.classList.toggle('error',main!==100);b.classList.toggle('error',sub!==100)}
async function save(e){e.preventDefault();const f=e.currentTarget,body={};for(const k of ['skillWeight','projectWeight','experienceWeight','educationWeight','dutyWeight','productWeight','industryWeight','tenureWeight','companyEnvironmentWeight'])body[k]=Number(f.elements[k].value);body.ruleJson=null;body.rowVersion=f.dataset.version;try{await api(`/api/jobs/${f.dataset.id}/score-config/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});show('评分权重已保存。下次启动评分时将生成使用新参数的独立排行。');await load()}catch(x){show(x.message)}}
async function queueScore(id,name){if(!confirm(`确认对“${name}”启动新一轮评分？本次将生成新的独立排行，不覆盖历史排行。`))return;try{const r=await api(`/api/jobs/${id}/score`,{method:'POST'});show(`第 ${r.runNo} 次评分已创建，共 ${r.queued} 个任务。`);await openRanking(id,name,false,r.runId)}catch(x){show(x.message)}}
async function openRanking(id,name,history=false,selectedRunId=null){rankingJob=id;rankingName=name;rankingPage=1;clearTimeout(rankingTimer);document.getElementById('ranking-resume-from').value='';document.getElementById('ranking-resume-to').value='';document.getElementById('ranking-talent-id').value='';document.getElementById('ranking-title').textContent=`${name} · ${history?'历史排行':'评分排行'}`;document.getElementById('ranking').showModal();try{const runs=await api(`/api/jobs/${id}/score-runs`),select=document.getElementById('ranking-run');select.innerHTML=runs.map(r=>`<option value="${r.id}">第 ${r.runNo} 次 · ${new Date(r.createTime+'Z').toLocaleString()} · V${r.scoreConfigVersion}</option>`).join('');if(!runs.length){rankingRunId=0;document.getElementById('ranking-state').textContent='暂无评分历史';document.getElementById('ranking-params').textContent='';document.getElementById('ranking-rows').innerHTML='<tr><td colspan="11">暂无评分结果</td></tr>';return}rankingRunId=selectedRunId||runs[0].id;select.value=String(rankingRunId);await loadRanking()}catch(x){show(x.message)}}
function closeRanking(){clearTimeout(rankingTimer);document.getElementById('ranking').close()}
async function loadRanking(){if(!rankingJob||!rankingRunId)return;clearTimeout(rankingTimer);const resumeFrom=document.getElementById('ranking-resume-from').value,resumeTo=document.getElementById('ranking-resume-to').value,talentId=document.getElementById('ranking-talent-id').value.trim();if(resumeFrom&&resumeTo&&resumeFrom>resumeTo){document.getElementById('ranking-state').textContent='开始日期不能晚于结束日期';return}if(talentId&&!/^\d+$/.test(talentId)){document.getElementById('ranking-state').textContent='51JOB人才ID必须是数字';return}try{const query=new URLSearchParams({runId:String(rankingRunId),page:String(rankingPage),pageSize:'20'});if(resumeFrom)query.set('resumeFrom',resumeFrom);if(resumeTo)query.set('resumeTo',resumeTo);if(talentId)query.set('talentId',talentId);const x=await api(`/api/jobs/${rankingJob}/ranking?${query}`),r=x.run;document.getElementById('ranking-state').textContent=`等待 ${x.waitingCount} · 处理中 ${x.runningCount} · 失败 ${x.failedCount} · 成功 ${x.totalCount} · 取消 ${r?.cancelledCount||0}`;document.getElementById('ranking-params').innerHTML=r?`<strong>第 ${r.runNo} 次评分参数（V${r.scoreConfigVersion}）</strong><span>一级：技能 ${r.skillWeight}% · 项目 ${r.projectWeight}% · 经验/行业 ${r.experienceWeight}% · 学历 ${r.educationWeight}%</span><span>经验内部：职责 ${r.dutyWeight}% · 产品 ${r.productWeight}% · 行业 ${r.industryWeight}% · 年限 ${r.tenureWeight}% · 公司环境 ${r.companyEnvironmentWeight}%</span>`:'';document.getElementById('ranking-rows').innerHTML=x.items.map((v,i)=>`<tr><td>${(x.page-1)*x.pageSize+i+1}</td><td><a href="/candidates/${v.candidateId}">${h(v.candidateName)}</a></td><td>${new Date(v.resumeImportTime+'Z').toLocaleDateString()}</td><td><strong>${score(v.aiScore)}</strong></td><td>${score(v.skillScore)}</td><td>${score(v.projectScore)}</td><td>${score(v.experienceScore)}</td><td>${score(v.educationScore)}</td><td>${h(v.currentCompany||'-')}</td><td>${h(v.recommendation||'-')}</td><td class="favorite-cell"><button type="button" class="ranking-favorite ${v.isFavorite?'favorite-active':'secondary'}" onclick="toggleFavorite(${v.candidateJobId},${v.isFavorite})">${v.isFavorite?'取消收藏':'收藏简历'}</button></td></tr>`).join('')||'<tr><td colspan="11">当前评分批次中未找到该51JOB人才ID的成功评分结果</td></tr>';const pages=Math.max(1,Math.ceil(x.totalCount/x.pageSize));document.getElementById('ranking-page').textContent=`第 ${x.page}/${pages} 页，共 ${x.totalCount} 条`;document.getElementById('ranking-prev').disabled=x.page<=1;document.getElementById('ranking-next').disabled=x.page>=pages;if(x.waitingCount+x.runningCount>0)rankingTimer=setTimeout(loadRanking,2000)}catch(x){show(x.message)}}
async function toggleFavorite(candidateJobId,isFavorite){const state=document.getElementById('ranking-state');state.textContent=isFavorite?'正在取消收藏…':'正在收藏…';try{await api(`/api/candidate-jobs/${candidateJobId}/${isFavorite?'unfavorite':'favorite'}`,{method:'POST'});await loadRanking()}catch(x){state.textContent='收藏操作失败：'+x.message}}
document.getElementById('job-filter').onchange=renderScores;document.getElementById('ranking-run').onchange=e=>{rankingRunId=Number(e.target.value);rankingPage=1;loadRanking()};document.getElementById('ranking-query').onclick=()=>{rankingPage=1;loadRanking()};document.getElementById('ranking-clear-date').onclick=()=>{document.getElementById('ranking-resume-from').value='';document.getElementById('ranking-resume-to').value='';document.getElementById('ranking-talent-id').value='';rankingPage=1;loadRanking()};document.getElementById('ranking-talent-id').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();rankingPage=1;loadRanking()}};document.getElementById('ranking-prev').onclick=()=>{if(rankingPage>1){rankingPage--;loadRanking()}};document.getElementById('ranking-next').onclick=()=>{rankingPage++;loadRanking()};load().catch(x=>show(x.message));
</script>}
