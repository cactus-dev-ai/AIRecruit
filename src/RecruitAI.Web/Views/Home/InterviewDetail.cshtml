@model long
@{ ViewData["Title"]="面试详情"; }
<div class="page-head"><div><h1>面试详情 #@Model</h1><p id="subtitle" class="muted">加载中…</p></div><div class="actions"><a class="button secondary" href="/interviews">返回列表</a><a id="question-link" class="button secondary" href="#">查看题集</a><button id="revoke" class="danger" onclick="revoke()" hidden>撤销邀请</button><button id="abort" class="danger" onclick="abortSession()" hidden>终止面试</button></div></div>
<div id="message" class="notice" hidden></div>
<div class="detail-cards"><div><span>邀请状态</span><strong id="invitation-status">—</strong><small id="expire">—</small></div><div><span>面试状态</span><strong id="session-status">—</strong><small id="times">—</small></div><div><span>AI 总分</span><strong id="score">—</strong><small id="recommendation">—</small></div><div><span>联系方式</span><strong id="contact">—</strong><small>仅供招聘流程使用</small></div></div>
<section><h2>邀请通知</h2><div id="deliveries"></div></section>
<section><div class="section-head"><div><h2>AI 面试报告</h2><p class="muted">提交后根据简历证据和逐题语音转写生成报告与评分。</p></div><button id="submit-report" onclick="submitReport()" hidden>提交</button></div><div id="report" class="report-grid"></div></section>
<section><div class="section-head"><h2>逐题记录与转写</h2></div><div id="turns"></div></section>
<dialog id="correct-dialog" class="interview-dialog"><form id="correct-form" method="dialog"><div class="dialog-head"><h2>修正转写</h2><button type="button" class="dialog-close" onclick="document.getElementById('correct-dialog').close()">×</button></div><label>修正后文本<textarea id="correct-text" maxlength="20000" required></textarea></label><label>修正原因<textarea id="correct-reason" maxlength="500" required></textarea></label><p class="muted">原文和修正记录将保留审计。</p><div class="dialog-actions"><button type="button" class="secondary" onclick="document.getElementById('correct-dialog').close()">取消</button><button>保存修正</button></div></form></dialog>
@section Scripts{<script>
const id=@Model;let data,currentTurn;const msg=document.getElementById('message');const h=v=>{const d=document.createElement('div');d.textContent=v??'';return d.innerHTML};const fmt=v=>v?new Date(v).toLocaleString('zh-CN'):'—';function show(v,e=false){msg.textContent=v;msg.className=e?'notice error':'notice';msg.hidden=false}
async function load(){data=await api('/api/interviews/invitations/'+id);document.getElementById('subtitle').textContent=`${data.candidateName} · ${data.jobName}`;document.getElementById('question-link').href='/interviews/question-sets/'+data.questionSetId;document.getElementById('invitation-status').textContent=data.invitationStatus;document.getElementById('expire').textContent='有效至 '+fmt(data.expireTime);document.getElementById('session-status').textContent=data.sessionStatus||'未创建';document.getElementById('times').textContent=data.startedTime?'开始 '+fmt(data.startedTime):'候选人尚未进入 H5';document.getElementById('score').textContent=data.overallScore==null?'—':data.overallScore+' 分';document.getElementById('recommendation').textContent=data.recommendation||'暂无结论';document.getElementById('contact').textContent=[data.phone,data.email].filter(Boolean).join(' / ')||'—';document.getElementById('revoke').hidden=!['CREATED','NOTIFIED','OPENED','VERIFIED'].includes(data.invitationStatus);document.getElementById('abort').hidden=!data.sessionId||!['NOT_STARTED','DEVICE_CHECK','IN_PROGRESS','PAUSED','PROCESSING'].includes(data.sessionStatus);document.getElementById('submit-report').hidden=!data.sessionId||!['SUBMITTED','COMPLETED','REVIEW_REQUIRED'].includes(data.sessionStatus);renderDeliveries();renderReport();renderTurns()}
function renderDeliveries(){document.getElementById('deliveries').innerHTML=data.deliveries?.length?`<table><thead><tr><th>渠道</th><th>状态</th><th>接收目标</th><th>结果</th></tr></thead><tbody>${data.deliveries.map(x=>`<tr><td>${x.channel==='EMAIL'?'邮件':'短信'}</td><td>${x.status==='SENT'?'已发送':'发送失败'}</td><td>${h(x.maskedDestination)}</td><td>${h(x.errorMessage||x.errorCode||'服务商已接受')}</td></tr>`).join('')}</tbody></table>`:'<p class="muted">本邀请未选择自动通知，可复制邀请内容后人工发送。</p>'}
function block(title,value){return `<div><h3>${title}</h3><p>${h(value||'暂无')}</p></div>`}function renderReport(){let dimensions='暂无';try{const scores=JSON.parse(data.dimensionScoresJson||'{}');dimensions=Object.entries(scores).map(([k,v])=>`${k}：${v} 分`).join('；')||'暂无'}catch{}document.getElementById('report').innerHTML=block('简历关键信息',data.resumeKeyInfo)+block('语音面试信息',data.voiceInterviewInfo)+block('综合评分',data.overallScore==null?'暂无':`${data.overallScore} 分；${dimensions}`)+block('综合摘要',data.reportSummary)+block('优势',data.strengths)+block('关注点',data.concerns)+block('建议',data.recommendation)}
function renderTurns(){document.getElementById('turns').innerHTML=data.turns.length?data.turns.map(t=>`<article class="turn-card"><header><strong>第 ${t.sequenceNo} 题</strong><span class="status">${h(t.status)}</span><small>${t.durationMs==null?'':Math.round(t.durationMs/1000)+' 秒'}</small></header><h3>${h(t.promptText)}</h3><div class="transcript">${h(t.transcript||'暂无最终转写')}</div><button class="secondary" onclick="correct(${t.id})">修正转写</button></article>`).join(''):'<div class="empty-state">暂无逐题记录。候选人通过 H5 完成面试后，此处显示录音证据和转写。</div>'}
async function revoke(){if(!confirm('撤销后候选人将不能使用该邀请。是否继续？'))return;await api(`/api/interviews/invitations/${id}/revoke`,{method:'POST'});show('邀请已撤销。');await load()}async function abortSession(){const reason=prompt('请输入终止原因：');if(!reason)return;await api(`/api/interviews/sessions/${data.sessionId}/abort`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason})});show('面试场次已终止。');await load()}
async function submitReport(){if(!confirm('确认提交并生成 AI 面试报告？'))return;const button=document.getElementById('submit-report');button.disabled=true;button.textContent='报告生成中…';try{await api(`/api/interviews/sessions/${data.sessionId}/submit-report`,{method:'POST'});show('提交成功，报告已生成。');await load()}catch(e){show(e.message,true)}finally{button.disabled=false;button.textContent='提交'}}
function correct(turnId){currentTurn=data.turns.find(x=>x.id===turnId);document.getElementById('correct-text').value=currentTurn.transcript||'';document.getElementById('correct-reason').value='';document.getElementById('correct-dialog').showModal()}document.getElementById('correct-form').onsubmit=async e=>{e.preventDefault();await api(`/api/interviews/turns/${currentTurn.id}/correct`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({correctedTranscript:document.getElementById('correct-text').value,reason:document.getElementById('correct-reason').value,rowVersion:currentTurn.rowVersion})});document.getElementById('correct-dialog').close();show('转写已修正并保留审计记录。');await load()};
load().catch(x=>show(x.message,true));
</script>}
