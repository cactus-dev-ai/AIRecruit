@model long
@{ ViewData["Title"]="候选人详情"; }
<div class="page-head"><h1>候选人详情 #@Model</h1><button type="button" class="secondary" onclick="returnToPreviousPage()">返回</button></div><div id="message" class="notice" hidden></div><form id="candidate" class="panel"><label>姓名<input name="name" maxlength="100"></label><label>手机<input name="phone" maxlength="30"></label><label>邮箱<input name="email" maxlength="254"></label><button>保存</button></form><section class="panel"><div><h2>当前档案</h2><dl id="profile" class="profile-grid"></dl><h3>技能</h3><p id="skills"></p></div></section><section><h2>工作经历</h2><div id="work"></div></section><section><h2>教育经历</h2><div id="education"></div></section><section><h2>项目经历</h2><div id="projects"></div></section><section><h2>数据库原始简历正文</h2><pre id="raw-text" class="raw-text"></pre></section><section><h2>简历版本</h2><div id="resumes"></div></section>
@section Scripts{<script>
const id=@Model;let data;const msg=document.getElementById('message');function returnToPreviousPage(){if(history.length>1)history.back();else location.href='/candidates'}function show(v,isError=false){msg.textContent=v;msg.className=isError?'notice error':'notice';msg.hidden=false}function date(v){return v?new Date(v).toLocaleDateString():'至今'}function empty(v){return v||'—'}function rows(items,render){return items.length?`<table><tbody>${items.map(render).join('')}</tbody></table>`:'暂无'}async function load(){data=await api('/api/candidates/'+id);for(const k of ['name','phone','email'])document.querySelector(`[name=${k}]`).value=data.candidate[k]||'';const profile=[['来源',data.resumeSource||data.candidate.source],['人才ID',data.talentId],['最高学历',data.candidate.highestEducation],['工作年限',data.candidate.totalExperienceMonths?`${Math.floor(data.candidate.totalExperienceMonths/12)}年${data.candidate.totalExperienceMonths%12}个月`:'—'],['当前公司',data.currentCompany],['求职意向',data.currentTitle],['摘要',data.summary]].map(x=>`<dt>${h(x[0])}</dt><dd>${h(empty(x[1]))}</dd>`).join('');document.getElementById('profile').innerHTML=profile;document.getElementById('skills').textContent=data.skills.join('、')||'暂无（JSON本地导入未做AI技能推断）';document.getElementById('work').innerHTML=rows(data.workExperiences,x=>`<tr><td>${h(x.companyName)}</td><td>${h(empty(x.jobTitle))}</td><td>${date(x.startDate)} - ${date(x.endDate)}</td><td>${h(empty(x.description))}</td></tr>`);document.getElementById('education').innerHTML=rows(data.educations,x=>`<tr><td>${h(x.schoolName)}</td><td>${h(empty(x.major))}</td><td>${h(empty(x.degree))}</td><td>${date(x.startDate)} - ${date(x.endDate)}</td></tr>`);document.getElementById('projects').innerHTML=rows(data.projects,x=>`<tr><td>${h(x.projectName)}</td><td>${h(empty(x.roleName))}</td><td>${h(empty(x.technology))}</td><td>${date(x.startDate)} - ${date(x.endDate)}</td></tr>`);document.getElementById('raw-text').textContent=data.rawText||'暂无正文';document.getElementById('resumes').innerHTML=data.resumes.map(x=>`<div class="failed-item"><span>${h(x.fileName)} · ${(x.fileSize/1048576).toFixed(2)}MB · ${x.parseStatus}${x.isOptimized?' · 已去图优化':''}</span><a class="button secondary" href="/api/resumes/${x.id}/download">下载</a></div>`).join('')}
document.getElementById('candidate').onsubmit=async e=>{e.preventDefault();const button=e.target.querySelector('button');button.disabled=true;try{const f=Object.fromEntries(new FormData(e.target));f.rowVersion=data.candidate.rowVersion;await api(`/api/candidates/${id}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(f)});show('候选人已保存。');await load()}catch(x){show(x.message,true)}finally{button.disabled=false}};function h(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}load().catch(x=>show(x.message,true));
</script>}
