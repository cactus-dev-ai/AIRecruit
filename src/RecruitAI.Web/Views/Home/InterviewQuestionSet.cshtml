@model long
@{ ViewData["Title"]="候选人题集审核"; }
<div class="page-head"><div><h1>候选人题集审议 #@Model</h1><p id="subtitle" class="muted">加载中…</p></div><div class="actions"><a class="button secondary" href="/interviews">返回列表</a><button id="save" onclick="save()">保存审议稿</button><button id="confirm" onclick="freeze()">HR确认发布</button><button id="invite" onclick="document.getElementById('notify-dialog').showModal()" hidden>生成邀请</button></div></div>
<div id="message" class="notice" hidden></div>
<div class="panel question-set-meta"><div><strong>生成说明</strong><p>题集由AI结合候选人岗位评分、评分建议和已启用岗位方案创建。HR必须逐题审议、修改并确认发布，发布后才能生成邀请。</p></div><div><strong>状态</strong><p id="status"></p></div><div><strong>简历</strong><p id="resume"></p></div></div>
<div class="section-head"><h2>面试题目</h2><button id="add" class="secondary" onclick="addQuestion()">添加题目</button></div><div id="questions"></div>
<dialog id="notify-dialog" class="interview-dialog"><div class="dialog-body"><div class="dialog-head"><h2>生成面试邀请</h2><button class="dialog-close" onclick="document.getElementById('notify-dialog').close()">×</button></div><label>有效时长（小时）<input id="valid-hours" type="number" min="1" max="168" value="72"></label><p>通知候选人（可多选）</p><label class="check"><input id="notify-email" type="checkbox"> 发送邮件</label><label class="check"><input id="notify-sms" type="checkbox" onchange="syncSmsValidity()"> 发送短信</label><p class="muted">短信模板固定为收到短信后 72 小时内有效，选择短信时有效时长将锁定为 72 小时。未选择通知时由 HR 手动复制发送。</p><div class="dialog-actions"><button class="secondary" onclick="document.getElementById('notify-dialog').close()">取消</button><button id="create-invite-button" onclick="createInvite()">生成并通知</button></div></div></dialog>
<dialog id="invite-dialog" class="interview-dialog"><div class="dialog-body"><div class="dialog-head"><h2>邀请已生成</h2><button class="dialog-close" onclick="document.getElementById('invite-dialog').close()">×</button></div><p class="notice warning">邀请码只显示本次，请将 H5 链接和邀请码妥善发送给候选人。</p><div id="delivery-results"></div><label>H5 面试链接<input id="mini-name" readonly></label><label>面试邀请码<input id="fallback-code" class="code-input" readonly></label><label>邀请内容<textarea id="invite-text" readonly></textarea></label><div class="dialog-actions"><button class="secondary" onclick="copyInvite()">复制邀请内容</button><a id="detail-link" class="button" href="#">进入面试详情</a></div></div></dialog>
@section Scripts{<script>
const id=@Model;let data;const msg=document.getElementById('message');const h=v=>{const d=document.createElement('div');d.textContent=v??'';return d.innerHTML};function show(v,e=false){msg.textContent=v;msg.className=e?'notice error':'notice';msg.hidden=false}function editable(){return data?.status==='DRAFT'}
async function load(){data=await api('/api/interviews/question-sets/'+id);const statusText={GENERATING:'AI创建中',DRAFT:'待HR审议',CONFIRMED:'HR已发布',STALE:'输入已变化',ARCHIVED:'已归档',FAILED:'创建失败'};document.getElementById('subtitle').textContent=`${data.candidateName} · ${data.jobName} · ${data.planName} · 第 ${data.revisionNo} 版`;document.getElementById('status').innerHTML=`<span class="status status-${data.status.toLowerCase()}">${statusText[data.status]||data.status}</span>`;document.getElementById('resume').textContent=`简历 #${data.resumeId}`;document.getElementById('questions').innerHTML='';data.questions.forEach(addQuestionFromData);for(const x of ['save','confirm','add'])document.getElementById(x).hidden=!editable();document.getElementById('invite').hidden=data.status!=='CONFIRMED'}
function addQuestion(type='FIXED'){addQuestionFromData({sequenceNo:document.querySelectorAll('.set-question').length+1,questionType:type,questionText:'',dimensionCode:'',generationReason:'HR人工补充',expectedEvidenceJson:'',maxAnswerSeconds:120,isRequired:true,isScored:true})}
function addQuestionFromData(q){const box=document.createElement('div');box.className='set-question';box.innerHTML=`<div class="question-number"></div><div class="form-grid"><label>题型<select class="q-type"><option value="FIXED">固定问题</option><option value="RESUME_VERIFY">简历核验</option><option value="GAP_PROBE">差距探查</option><option value="KNOWLEDGE_PROBE">知识能力探查</option><option value="FOLLOW_UP">动态追问</option><option value="CANDIDATE_QA">候选人提问</option><option value="END">结束语</option></select></label><label>评分维度<input class="q-dimension" maxlength="50" value="${h(q.dimensionCode||'')}"></label><label>回答秒数<input class="q-seconds" type="number" min="5" max="1800" value="${q.maxAnswerSeconds}"></label><label class="wide">问题<textarea class="q-text" maxlength="2000">${h(q.questionText)}</textarea></label><label class="wide">AI生成原因 / HR审议备注<input class="q-reason" maxlength="1000" value="${h(q.generationReason||'')}"></label><label class="wide">预期证据 JSON<textarea class="q-evidence" placeholder='可选，如 {"evidence":"项目交付结果"}'>${h(q.expectedEvidenceJson||'')}</textarea></label><label class="check"><input class="q-required" type="checkbox" ${q.isRequired?'checked':''}> 必答</label><label class="check"><input class="q-scored" type="checkbox" ${q.isScored?'checked':''}> 计分</label><button class="danger remove" type="button">删除</button></div>`;box.querySelector('.q-type').value=q.questionType;box.querySelector('.remove').onclick=()=>{box.remove();renumber()};document.getElementById('questions').appendChild(box);if(!editable())box.querySelectorAll('input,select,textarea,button').forEach(x=>x.disabled=true);renumber()}
function renumber(){[...document.querySelectorAll('.question-number')].forEach((x,i)=>x.textContent=`第 ${i+1} 题`)}function questions(){return[...document.querySelectorAll('.set-question')].map((x,i)=>({id:0,sequenceNo:i+1,questionType:x.querySelector('.q-type').value,questionText:x.querySelector('.q-text').value,dimensionCode:x.querySelector('.q-dimension').value||null,generationReason:x.querySelector('.q-reason').value||null,expectedEvidenceJson:x.querySelector('.q-evidence').value||null,maxAnswerSeconds:+x.querySelector('.q-seconds').value,isRequired:x.querySelector('.q-required').checked,isScored:x.querySelector('.q-scored').checked,status:'DRAFT',rowVersion:''}))}
async function save(){await api(`/api/interviews/question-sets/${id}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({rowVersion:data.rowVersion,questions:questions()})});show('题集草稿已保存。');await load()}
async function freeze(){if(!confirm('HR确认发布后题目不能再修改。是否继续？'))return;await save();await api(`/api/interviews/question-sets/${id}/confirm`,{method:'POST'});show('题集已由HR确认发布，可以生成邀请。');await load()}
function syncSmsValidity(){const sms=document.getElementById('notify-sms').checked;const hours=document.getElementById('valid-hours');if(sms)hours.value=72;hours.disabled=sms}async function createInvite(){const button=document.getElementById('create-invite-button');button.disabled=true;button.textContent='正在生成并发送…';try{const channels=[];if(document.getElementById('notify-email').checked)channels.push('EMAIL');if(document.getElementById('notify-sms').checked)channels.push('SMS');const x=await api('/api/interviews/invitations',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({questionSetId:id,validHours:+document.getElementById('valid-hours').value,notificationChannels:channels})});document.getElementById('notify-dialog').close();document.getElementById('mini-name').value=x.h5Url;document.getElementById('fallback-code').value=x.fallbackCode;document.getElementById('invite-text').value=x.invitationText;document.getElementById('detail-link').href='/interviews/'+x.invitationId;const box=document.getElementById('delivery-results');box.innerHTML=x.deliveries.length?x.deliveries.map(d=>`<p class="notice ${d.status==='SENT'?'':'error'}">${d.channel==='EMAIL'?'邮件':'短信'}：${d.status==='SENT'?'已发送至 '+h(d.maskedDestination):'发送失败：'+h(d.errorMessage||d.errorCode)}</p>`).join(''):'<p class="notice">邀请已生成，尚未自动通知。</p>';document.getElementById('invite-dialog').showModal()}catch(x){show(x.message,true)}finally{button.disabled=false;button.textContent='生成并通知'}}async function copyInvite(){await navigator.clipboard.writeText(document.getElementById('invite-text').value);show('邀请内容已复制。')}
load().catch(x=>show(x.message,true));
</script>}
