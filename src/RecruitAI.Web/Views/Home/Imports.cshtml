@{ ViewData["Title"] = "简历导入"; }
<div class="page-head"><div><h1>简历导入</h1><p>51JOB JSON 继续使用原有审议流程；HR 可手动上传 PDF/DOCX，由独立人工上传 Agent 直接解析入库。</p></div><div class="actions"><button id="open-manual-upload" type="button">手动上传简历</button></div></div>
<div id="message" class="notice" hidden></div>
<dialog id="manual-upload-dialog" class="interview-dialog manual-upload-dialog"><div class="dialog-body"><div class="dialog-head"><h2>手动上传简历</h2><button class="dialog-close" type="button" id="close-manual-upload" aria-label="关闭">×</button></div><div id="manual-message" class="notice" hidden></div><p class="muted">选择应聘岗位后可批量上传。支持 PDF、DOCX，单份不超过 20MB，一次最多 10 份；扫描版 PDF 请先完成 OCR。</p><label>应聘岗位<select id="manual-job"><option value="">请选择开放岗位</option></select></label><label>批量选择简历<input id="manual-files" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple></label><p id="manual-file-summary" class="muted">尚未选择文件</p><div class="dialog-actions"><button id="cancel-manual-upload" class="secondary" type="button">取消</button><button id="manual-upload" type="button">上传简历</button></div></div></dialog>
<table><thead><tr><th>批次</th><th>状态</th><th>源文件</th><th>成功/失败</th><th>创建人</th><th>时间</th></tr></thead><tbody id="rows"></tbody></table>
<div class="actions pager"><button id="previous" class="secondary" type="button">上一页</button><span id="page-info" class="muted"></span><button id="next" class="secondary" type="button">下一页</button></div>
<section><h2>导入异常人工处理</h2><p class="muted">查看异常原因；确认文件乱码、损坏或无业务价值后清理。51JOB JSON 可退回上传目录，人工 PDF/DOCX 可重新选择文件上传。</p><div id="failed"></div></section>
@section Scripts {<script>
const msg=document.getElementById('message');let page=1;
function show(t){msg.textContent=t;msg.hidden=false}
function showUpload(t){const box=document.getElementById('manual-message');box.textContent=t;box.hidden=false}
async function loadJobs(){const jobs=await api('/api/jobs?page=1&pageSize=100&status=OPEN');document.getElementById('manual-job').insertAdjacentHTML('beforeend',jobs.map(x=>`<option value="${x.id}">${escapeHtml(x.name)}</option>`).join(''))}
const manualDialog=document.getElementById('manual-upload-dialog');document.getElementById('open-manual-upload').onclick=()=>{document.getElementById('manual-message').hidden=true;manualDialog.showModal()};document.getElementById('close-manual-upload').onclick=()=>manualDialog.close();document.getElementById('cancel-manual-upload').onclick=()=>manualDialog.close();document.getElementById('manual-files').onchange=e=>{const files=[...e.target.files],total=files.reduce((sum,file)=>sum+file.size,0);document.getElementById('manual-file-summary').textContent=files.length?`已选择 ${files.length} 份简历，共 ${(total/1024/1024).toFixed(2)} MB`:'尚未选择文件'};
document.getElementById('manual-upload').onclick=async()=>{const button=document.getElementById('manual-upload'),jobId=document.getElementById('manual-job').value,files=[...document.getElementById('manual-files').files];if(!jobId)return showUpload('请选择应聘岗位。');if(!files.length)return showUpload('请选择 PDF 或 DOCX 简历。');button.disabled=true;button.textContent='正在上传…';try{const form=new FormData();form.append('jobId',jobId);files.forEach(file=>form.append('files',file));const result=await api('/api/resume-imports/manual',{method:'POST',body:form});document.getElementById('manual-files').value='';document.getElementById('manual-file-summary').textContent='尚未选择文件';manualDialog.close();show(`${result.message} 批次 #${result.batchId}`);page=1;await load()}catch(x){showUpload(x.message)}finally{button.disabled=false;button.textContent='上传简历'}};
async function load(){const data=await api(`/api/resume-imports?page=${page}&pageSize=5`);page=data.page;document.getElementById('rows').innerHTML=data.items.map(x=>`<tr><td><a href="/imports/${x.id}">#${x.id}</a></td><td>${x.status}</td><td>${x.sourceFileCount}</td><td>${x.successCount}/${x.failedCount}</td><td>${x.createdBy}</td><td>${new Date(x.createTime+'Z').toLocaleString()}</td></tr>`).join('')||'<tr><td colspan="6">暂无批次</td></tr>';const pages=Math.max(1,Math.ceil(data.totalCount/data.pageSize));document.getElementById('page-info').textContent=`第 ${data.page} / ${pages} 页，共 ${data.totalCount} 条`;document.getElementById('previous').disabled=data.page<=1;document.getElementById('next').disabled=data.page>=pages;const f=await api('/api/resume-imports/failed-files');document.getElementById('failed').innerHTML=f.length?f.map(x=>`<div class="failed-item"><span><b>${escapeHtml(x.originalFileName)}</b> · ${escapeHtml(x.errorCode||x.status)} · ${escapeHtml(x.errorMessage||'')}</span><div class="actions"><button class="secondary" onclick="preview(${x.id})">查看原因</button>${x.sourceType==='THIRD_PARTY_IMPORT'?`<button class="secondary" onclick="returnToInbox(${x.id})">退回重传</button>`:''}<button class="danger" onclick="purge(${x.id})">确认清理</button></div></div>`).join(''):'无异常文件';}
document.getElementById('previous').onclick=()=>{if(page>1){page--;load().catch(x=>show(x.message));}};document.getElementById('next').onclick=()=>{page++;load().catch(x=>show(x.message));};
async function purge(id){const reason=prompt('请输入清理原因（1-500字）');if(!reason)return;await api(`/api/resume-imports/failed-files/${id}/purge`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason})});await load();}
async function returnToInbox(id){const reason=prompt('请输入退回原因（1-500字）');if(!reason)return;await api(`/api/resume-imports/failed-files/${id}/return`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason})});await load();}
async function preview(id){const p=await api(`/api/resume-imports/failed-files/${id}/preview`);alert(`${p.originalFileName}\n${p.errorCode||''} ${p.errorMessage||''}\n\n${p.previewText||'没有可显示的JSON正文。'}`);}
function escapeHtml(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML} loadJobs().then(load).catch(x=>show(x.message));
</script>}
