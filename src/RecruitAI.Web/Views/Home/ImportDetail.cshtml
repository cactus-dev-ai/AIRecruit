@model long
@{ ViewData["Title"] = "导入批次"; }
<div class="page-head"><div><h1>导入批次 #@Model</h1><p id="summary">加载中…</p></div><a class="button secondary" href="/imports">返回</a></div><div id="message" class="notice" hidden></div>
<div class="panel"><label>目标岗位ID（逗号分隔，可留空）<input id="jobs" /></label><label>备注<input id="remark" maxlength="500" /></label><button id="confirm">确认并开始导入</button><button id="cancel" class="danger">取消审阅</button></div>
<table><thead><tr><th>来源</th><th>文件</th><th>大小</th><th>状态</th><th>提示</th><th></th></tr></thead><tbody id="files"></tbody></table>
@section Scripts {<script>
const id=@Model;let batch;let pollTimer;const msg=document.getElementById('message');function show(t){msg.textContent=t;msg.hidden=false}
function counts(files){return {success:files.filter(x=>x.status==='SUCCESS').length,failed:files.filter(x=>x.status==='FAILED'||x.status==='REJECTED').length,active:files.filter(x=>['QUEUED','PROCESSING','SPLIT'].includes(x.status)).length,ready:files.filter(x=>x.status==='REVIEW_READY').length};}
function schedulePoll(){clearTimeout(pollTimer);if(['QUEUED','PROCESSING'].includes(batch.status)){pollTimer=setTimeout(()=>load().catch(x=>show(x.message)),2000);}}
async function load(){const d=await api('/api/resume-imports/'+id);batch=d.batch;const c=counts(d.files);document.getElementById('summary').textContent=`${batch.status} · 源文件 ${batch.sourceFileCount} · 成功 ${c.success} · 失败 ${c.failed} · 执行中 ${c.active}`;document.getElementById('remark').value=batch.remark||'';document.getElementById('jobs').value=d.jobIds.join(',');document.getElementById('files').innerHTML=d.files.map(x=>`<tr><td>${x.sourceType}</td><td>${esc(x.originalFileName)}</td><td>${(x.fileSize/1048576).toFixed(2)} MB</td><td>${x.status}</td><td>${esc(x.errorMessage||'')}</td><td>${x.status==='REVIEW_READY'?`<button onclick="rejectFile(${x.id})">拒绝</button>`:''}</td></tr>`).join('');const open=batch.status==='REVIEWING';const canConfirm=open&&c.ready>0;document.getElementById('confirm').disabled=!canConfirm;document.getElementById('cancel').disabled=!open;if(['QUEUED','PROCESSING'].includes(batch.status)){show(`本批已进入AI任务队列：成功 ${c.success}，失败 ${c.failed}，剩余 ${c.active}。可返回列表继续处理下一批。`);schedulePoll();return;}clearTimeout(pollTimer);if(open&&!canConfirm)show('本批没有可导入文件，请在异常列表处理后重新扫描。');else if(!open)show(`本批状态为 ${batch.status}，成功 ${c.success}，失败 ${c.failed}。`);}
async function rejectFile(fileId){if(!confirm('将文件移入异常目录？'))return;await api(`/api/resume-imports/${id}/files/${fileId}/reject`,{method:'POST'});await load()}
document.getElementById('confirm').onclick=async()=>{const jobIds=document.getElementById('jobs').value.split(',').map(x=>x.trim()).filter(Boolean).map(Number);const button=document.getElementById('confirm');button.disabled=true;try{const r=await api(`/api/resume-imports/${id}/confirm`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({jobIds,remark:document.getElementById('remark').value,rowVersion:batch.rowVersion})});const hasNext=!!r.nextBatchId;show(`本批 ${r.taskCount} 个文件已加入AI任务队列。${hasNext?`下一批 #${r.nextBatchId} 已扫描完成，即将打开。`:'可继续上传或处理其他批次。'}`);setTimeout(()=>location.href=hasNext?`/imports/${r.nextBatchId}`:'/imports',700)}catch(x){show(x.message);button.disabled=false}};
document.getElementById('cancel').onclick=async()=>{if(!confirm('取消后，待审阅文件将退回来源目录。'))return;await api(`/api/resume-imports/${id}/cancel-review`,{method:'POST'});location.href='/imports'};function esc(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}load().catch(x=>show(x.message));
</script>}
