@{ ViewData["Title"]="岗位管理"; ViewData["MainClass"]="page-wide"; }
<div class="page-head"><div><h1>岗位管理</h1><p>可为每个岗位设置年龄和期望月薪上限。一键清理会把超限候选人标记为“不合适”并移出岗位候选池，原始简历和审计记录仍会保留。</p></div></div>
<form id="create" class="panel"><label>岗位名称<input name="name" required maxlength="200"></label><p class="muted">新岗位会同时建立一份岗位画像草稿，进入岗位详情后由HR完善并发布。</p><button>新建草稿</button></form>
<div id="message" class="notice" hidden></div>
<table><thead><tr><th>岗位</th><th>状态</th><th>候选人数</th><th>年龄上限</th><th>期望月薪上限</th><th>评分版本</th><th>更新时间</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table>
@section Scripts{<script>
const msg=document.getElementById('message');function show(v){msg.textContent=v;msg.hidden=false}
let jobs=[];
function statusName(v){return v==='OPEN'?'开放':v==='DRAFT'?'草稿':v==='CLOSED'?'已关闭':v}
async function load(){jobs=await api('/api/jobs?pageSize=100');document.getElementById('rows').innerHTML=jobs.map(x=>`<tr data-job="${x.id}"><td><a href="/jobs/${x.id}">${h(x.name)}</a></td><td>${statusName(x.status)}</td><td><strong>${x.resumeCount}</strong></td><td><div class="actions"><input class="job-limit" name="maxAge" type="number" min="16" max="80" placeholder="未设置" value="${x.maxCandidateAge??''}" aria-label="年龄上限"><button type="button" class="secondary" onclick="cleanupJob(${x.id},'AGE')">一键清理超龄</button></div></td><td><div class="actions"><input class="job-limit" name="maxSalary" type="number" min="1" max="1000000" step="100" placeholder="元/月" value="${x.maxExpectedMonthlySalary??''}" aria-label="期望月薪上限"><button type="button" class="secondary" onclick="cleanupJob(${x.id},'SALARY')">一键清理超薪酬</button></div></td><td>V${x.scoreConfigVersion}</td><td>${new Date(x.updateTime+'Z').toLocaleString()}</td><td><button type="button" class="secondary" onclick="saveRules(${x.id})">保存固定值</button> <button type="button" class="secondary" onclick="restoreCleanup(${x.id})">恢复已清理</button> <a class="button secondary" href="/jobs/${x.id}">改名/合并</a> ${x.resumeCount===0?`<button type="button" class="secondary" onclick="deleteJob(${x.id})">删除</button>`:'<span class="muted" title="该岗位已有相关简历，不能删除">不可删除</span>'}</td></tr>`).join('')||'<tr><td colspan="8">暂无岗位</td></tr>'}
function rules(id){const row=document.querySelector(`tr[data-job="${id}"]`),age=row.querySelector('[name=maxAge]').value,salary=row.querySelector('[name=maxSalary]').value;return{maxCandidateAge:age?Number(age):null,maxExpectedMonthlySalary:salary?Number(salary):null,rowVersion:jobs.find(x=>x.id===id).rowVersion}}
async function persistRules(id){await api(`/api/jobs/${id}/cleanup-rules/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(rules(id))})}
async function saveRules(id){try{await persistRules(id);show('岗位年龄及薪酬固定值已保存。');await load()}catch(x){show(x.message)}}
async function cleanupJob(id,type){const item=jobs.find(x=>x.id===id),r=rules(id),limit=type==='AGE'?r.maxCandidateAge:r.maxExpectedMonthlySalary,label=type==='AGE'?'年龄':'期望月薪';if(limit===null){show(`请先填写${label}上限。`);return}const text=type==='AGE'?`${limit}岁`:`${limit.toLocaleString()}元/月`;if(!confirm(`确认按“${item.name}”的${label}上限 ${text} 清理？\n超限候选人会标记为不合适，不会物理删除简历。`))return;try{await persistRules(id);const result=await api(`/api/jobs/${id}/cleanup/${type}`,{method:'POST'});show(`清理完成：检查 ${result.scannedCount} 人，清理 ${result.cleanedCount} 人，无法识别 ${result.unknownCount} 人（已保留）。`);await load()}catch(x){show(x.message)}}
async function restoreCleanup(id){const item=jobs.find(x=>x.id===id);if(!confirm(`确认恢复“${item.name}”中由年龄或薪酬一键清理的候选人吗？\n人工标记为不合适的候选人不会恢复。`))return;try{const result=await api(`/api/jobs/${id}/cleanup/restore`,{method:'POST'}),legacy=result.legacyRestoredCount?`，其中旧版兼容恢复 ${result.legacyRestoredCount} 人（恢复为待处理）`:'';show(`恢复完成：共恢复 ${result.restoredCount} 人${legacy}。`);await load()}catch(x){show(x.message)}}
async function deleteJob(id){const item=jobs.find(x=>x.id===id);if(!item)return;const name=item.name;if(!confirm(`确认删除岗位“${name}”吗？\n仅删除没有关联简历的岗位，删除后将不再显示。`))return;try{await api(`/api/jobs/${id}/archive`,{method:'POST'});show(`岗位“${name}”已删除。`);await load()}catch(x){show(x.message)}}
document.getElementById('create').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target),body={name:f.get('name'),description:null,requirement:'岗位画像待HR完善',skillRequirement:null,minExperienceMonths:null,educationRequirement:null,rowVersion:null};try{const r=await api('/api/jobs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});location.href='/jobs/'+r.id}catch(x){show(x.message)}};
function h(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}load().catch(x=>show(x.message));
</script>}
