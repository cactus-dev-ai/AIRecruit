@model long
@{ ViewData["Title"] = "知识导入冲突"; }
<div class="page-head"><div><h1>知识导入批次 #@Model</h1><p id="summary">加载中…</p></div><button id="confirm">确认合并RAG</button></div><div id="message" class="notice" hidden></div><div id="rows"></div>
@section Scripts {<script>
const id=@Model;let data;const msg=document.getElementById('message');function show(t){msg.textContent=t;msg.hidden=false}
async function load(){data=await api('/api/knowledge-imports/'+id);document.getElementById('summary').textContent=`${data.status} · 可导入 ${data.readyCount} · 重复 ${data.duplicateCount} · 冲突 ${data.conflictCount} · 非法 ${data.invalidCount}`;document.getElementById('confirm').disabled=data.status==='IMPORTED'||data.conflictCount+data.invalidCount>0;document.getElementById('rows').innerHTML=data.rows.map(r=>`<form class="knowledge-row" onsubmit="save(event,${r.id})"><b>Excel第${r.rowNumber}行 · ${r.status}</b><input name="code" value="${attr(r.code)}" maxlength="100"><input name="title" value="${attr(r.title)}" maxlength="300"><select name="documentType">${['JOB_REQUIREMENT','TECH_STANDARD','TALENT_STANDARD','SCORE_RULE','OTHER'].map(x=>`<option ${x===r.documentType?'selected':''}>${x}</option>`).join('')}</select><textarea name="content" maxlength="50000">${html(r.content)}</textarea><input type="hidden" name="rowVersion" value="${r.rowVersion}"><span class="error">${html(r.errorMessage||'')}</span><button>保存修正</button></form>`).join('')}
async function save(e,rowId){e.preventDefault();const f=new FormData(e.target),body=Object.fromEntries(f.entries());await api(`/api/knowledge-imports/${id}/rows/${rowId}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});await load()}
document.getElementById('confirm').onclick=async()=>{try{const r=await api(`/api/knowledge-imports/${id}/confirm`,{method:'POST'});show(`已合并${r.importedCount}条知识并创建索引任务。`);await load()}catch(x){show(x.message)}};function html(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}function attr(v){return html(v).replaceAll('"','&quot;')}load().catch(x=>show(x.message));
</script>}
