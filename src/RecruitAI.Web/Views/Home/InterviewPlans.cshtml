@{ ViewData["Title"]="面试方案"; }
<div class="page-head"><div><h1>面试方案</h1><p class="muted">按岗位维护固定题目、时长及录音同意文本版本。</p></div><div class="actions"><a class="button secondary" href="/interviews">返回面试列表</a><button onclick="newPlan()">新建方案</button></div></div>
<div id="message" class="notice" hidden></div><div id="plans"></div>
<dialog id="plan-dialog" class="interview-dialog wide-dialog"><form id="plan-form" method="dialog">
 <div class="dialog-head"><h2 id="plan-title">新建面试方案</h2><button type="button" class="dialog-close" onclick="closePlan()">×</button></div>
 <div class="form-grid"><label>岗位<select id="job-id" required></select></label><label>方案名称<input id="plan-name" maxlength="200" required></label><label>建议时长（分钟）<input id="duration" type="number" min="1" max="120" value="20" required></label><label>最长时长（分钟）<input id="max-duration" type="number" min="1" max="180" value="30" required></label><label>同意文本版本<input id="consent-version" maxlength="50" value="CONSENT-V1" required></label></div>
 <div class="section-head"><h3>方案题目</h3><button type="button" class="secondary" onclick="addQuestion()">添加题目</button></div><div id="questions"></div>
 <p id="plan-error" class="error" hidden></p><div class="dialog-actions"><button type="button" class="secondary" onclick="closePlan()">取消</button><button id="save-plan">保存草稿</button></div>
</form></dialog>
@section Scripts{<script>
let jobs=[],editing=null;const dialog=document.getElementById('plan-dialog'),msg=document.getElementById('message');const h=v=>{const d=document.createElement('div');d.textContent=v??'';return d.innerHTML};const fmt=v=>new Date(v).toLocaleString('zh-CN');function show(v,e=false){msg.textContent=v;msg.className=e?'notice error':'notice';msg.hidden=false}
function planActions(x){if(x.status==='DRAFT')return `<button class="secondary" onclick="editPlan(${x.id})">修改</button><button onclick="publishPlan(${x.id})">启用</button><button class="danger" onclick="deletePlan(${x.id})">删除</button>`;if(x.status==='ACTIVE')return `<button class="secondary" onclick="editPlan(${x.id})">查看</button><button onclick="clonePlan(${x.id})">复制修改</button><button class="danger" onclick="stopPlan(${x.id})">停用</button>`;return `<button class="secondary" onclick="editPlan(${x.id})">查看</button><button onclick="clonePlan(${x.id})">复制修改</button>`}
async function load(){jobs=await api('/api/jobs?page=1&pageSize=100');const items=await api('/api/interviews/plans');const statusText={DRAFT:'草稿',ACTIVE:'已启用',ARCHIVED:'已归档'};document.getElementById('plans').innerHTML=items.length?`<table><thead><tr><th>岗位</th><th>方案</th><th>版本</th><th>时长</th><th>状态</th><th>更新</th><th></th></tr></thead><tbody>${items.map(x=>`<tr><td>${h(x.jobName)}</td><td><strong>${h(x.name)}</strong></td><td>v${x.versionNo}</td><td>${x.durationMinutes} / 最长 ${x.maxSessionMinutes} 分钟</td><td><span class="status status-${x.status.toLowerCase()}">${statusText[x.status]||x.status}</span></td><td>${fmt(x.updateTime)}</td><td><div class="actions plan-actions">${planActions(x)}</div></td></tr>`).join('')}</tbody></table>`:'<div class="empty-state">暂无方案，请先新建。</div>'}
function jobOptions(selected){return jobs.map(x=>`<option value="${x.id}" ${x.id===selected?'selected':''}>${h(x.name)}</option>`).join('')}
function newPlan(){editing=null;document.querySelectorAll('#plan-form input,#plan-form select,#plan-form textarea,#plan-form button').forEach(x=>x.disabled=false);document.getElementById('plan-form').reset();document.getElementById('plan-title').textContent='新建面试方案';document.getElementById('job-id').innerHTML=jobOptions();document.getElementById('job-id').disabled=false;document.getElementById('duration').value=20;document.getElementById('max-duration').value=30;document.getElementById('consent-version').value='CONSENT-V1';document.getElementById('questions').innerHTML='';addQuestion('FIXED','请您做一个简短的自我介绍，并说明应聘本岗位的原因。','COMMUNICATION');addQuestion('END','本次面试即将结束，您还有什么需要补充的吗？',null,false);dialog.showModal()}
async function editPlan(id){editing=await api('/api/interviews/plans/'+id);document.getElementById('plan-title').textContent=(editing.status==='DRAFT'?'编辑':'查看')+'面试方案';document.getElementById('job-id').innerHTML=jobOptions(editing.jobId);document.getElementById('job-id').disabled=true;document.getElementById('plan-name').value=editing.name;document.getElementById('duration').value=editing.durationMinutes;document.getElementById('max-duration').value=editing.maxSessionMinutes;document.getElementById('consent-version').value=editing.consentTextVersion;document.getElementById('questions').innerHTML='';editing.questions.forEach(x=>addQuestion(x.questionType,x.questionText,x.dimensionCode,x.isScored,x.isRequired,x.maxAnswerSeconds,x.minTranscriptChars));document.querySelectorAll('#plan-form input,#plan-form select,#plan-form textarea,#plan-form button:not(.dialog-close)').forEach(x=>x.disabled=editing.status!=='DRAFT');document.querySelectorAll('.dialog-close').forEach(x=>x.disabled=false);dialog.showModal()}
function addQuestion(type='FIXED',text='',dimension='',scored=true,required=true,seconds=120,minChars=5){const box=document.createElement('div');box.className='question-editor';box.innerHTML=`<div class="drag-number"></div><label>类型<select class="q-type"><option value="FIXED">固定问题</option><option value="INTRO">开场介绍</option><option value="CONDITION">条件追问</option><option value="FOLLOW_UP">动态追问</option><option value="CANDIDATE_QA">候选人提问</option><option value="END">结束语</option></select></label><label>评分维度<input class="q-dimension" maxlength="50" value="${h(dimension||'')}"></label><label>回答秒数<input class="q-seconds" type="number" min="5" max="1800" value="${seconds}"></label><label>最少字数<input class="q-chars" type="number" min="0" max="4000" value="${minChars}"></label><label class="wide">题目<textarea class="q-text" maxlength="2000" required>${h(text)}</textarea></label><label class="check"><input class="q-required" type="checkbox" ${required?'checked':''}> 必答</label><label class="check"><input class="q-scored" type="checkbox" ${scored?'checked':''}> 计分</label><button type="button" class="danger remove-question">删除</button>`;box.querySelector('.q-type').value=type;box.querySelector('.remove-question').onclick=()=>{box.remove();renumber()};document.getElementById('questions').appendChild(box);renumber()}
function renumber(){[...document.querySelectorAll('.question-editor .drag-number')].forEach((x,i)=>x.textContent=i+1)}function closePlan(){dialog.close()}
function payload(){const qs=[...document.querySelectorAll('.question-editor')].map((x,i)=>({id:null,sequenceNo:i+1,questionType:x.querySelector('.q-type').value,questionText:x.querySelector('.q-text').value,dimensionCode:x.querySelector('.q-dimension').value||null,maxAnswerSeconds:+x.querySelector('.q-seconds').value,minTranscriptChars:+x.querySelector('.q-chars').value,isScored:x.querySelector('.q-scored').checked,isRequired:x.querySelector('.q-required').checked}));return{jobId:+document.getElementById('job-id').value,name:document.getElementById('plan-name').value,durationMinutes:+document.getElementById('duration').value,maxSessionMinutes:+document.getElementById('max-duration').value,consentTextVersion:document.getElementById('consent-version').value,rowVersion:editing?.rowVersion||null,questions:qs}}
document.getElementById('plan-form').onsubmit=async e=>{e.preventDefault();const error=document.getElementById('plan-error');error.hidden=true;try{if(editing)await api(`/api/interviews/plans/${editing.id}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())});else await api('/api/interviews/plans',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload())});dialog.close();show('面试方案已保存。');await load()}catch(x){error.textContent=x.message;error.hidden=false}};
async function publishPlan(id){if(!confirm('启用该方案后，同岗位原有启用方案将归档，且本方案不能再修改。是否继续？'))return;await api(`/api/interviews/plans/${id}/publish`,{method:'POST'});show('方案已启用。');await load()}
async function stopPlan(id){if(!confirm('停用后该岗位将不能继续创建新题集，已有题集和邀请不受影响。是否继续？'))return;await api(`/api/interviews/plans/${id}/stop`,{method:'POST'});show('方案已停用并转为历史版本。');await load()}
async function clonePlan(id){const result=await api(`/api/interviews/plans/${id}/clone`,{method:'POST'});show('已复制为新的草稿版本，请修改后再启用。');await load();await editPlan(result.id)}
async function deletePlan(id){if(!confirm('仅删除未被题集引用的草稿方案。删除后无法恢复，是否继续？'))return;await api(`/api/interviews/plans/${id}/delete`,{method:'POST'});show('草稿方案已删除。');await load()}
load().catch(x=>show(x.message,true));
</script>}
