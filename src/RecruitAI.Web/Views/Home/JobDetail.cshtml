@model long
@{ ViewData["Title"]="岗位详情"; }
<div class="page-head"><div><h1>岗位详情 #@Model</h1><p>修改名称会保留现有简历关系；只能把关联简历较少的岗位合并到关联简历更多的岗位。</p></div><a class="button secondary" href="/jobs">返回</a></div>
<div id="message" class="notice" hidden></div>
<form id="job" class="panel"><h2>基本信息</h2><label>岗位名称（简历类别，可直接改名）<input name="name" required maxlength="200"></label><div class="actions"><button>保存名称</button><button type="button" id="state">开放</button></div></form>
<section class="panel job-profile-panel"><div class="page-head"><div><h2>岗位画像</h2><p>岗位描述、要求和筛选依据统一在这里维护；发布后岗位将同步开放，画像进入RAG并可用于岗位评分。</p></div><strong id="profile-status"></strong></div><div id="profile-message" class="notice" hidden></div><label>画像标题<input id="profile-title" maxlength="300"></label><label>岗位画像内容<textarea id="profile-content" maxlength="50000" rows="18"></textarea></label><label>AI补充要求（可选）<input id="profile-instruction" maxlength="1000" placeholder="例如：补充汽车零部件行业经验、产品经验与排除项"></label><div class="actions"><button type="button" id="profile-ai" class="secondary">AI完善草稿</button><button type="button" id="profile-save">保存草稿</button><button type="button" id="profile-publish" class="secondary">发布岗位/RAG重建</button></div></section>
<section class="panel"><h2>评分配置与排行</h2><p>当前评分方案 V<span id="score-version"></span>。评分优先使用已发布岗位画像；尚未发布时使用当前主岗位画像，并冻结到本轮历史排行。</p><a class="button secondary" href="/scores">打开评分管理</a></section>
<form id="merge" class="panel merge-job-panel"><div class="merge-job-intro"><h2>合并岗位</h2><p class="muted">所有候选人、简历来源和外部岗位记录都会移动到目标岗位；两边同时存在的人才只保留一条目标岗位关系。当前岗位随后归档。</p><p id="merge-hint" class="muted"></p></div><label>目标岗位<select id="merge-target" required></select></label><label>合并原因<input id="merge-reason" maxlength="500" placeholder="例如：岗位名称重复"></label><button id="merge-submit" class="danger">合并并归档当前岗位</button></form>
@section Scripts{<script>
const id=@Model;let item,profile;const msg=document.getElementById('message'),profileMsg=document.getElementById('profile-message');function show(v){msg.textContent=v;msg.hidden=false}function showProfile(v){profileMsg.textContent=v;profileMsg.hidden=false}
async function loadProfile(){profile=await api(`/api/jobs/${id}/profile`);document.getElementById('profile-title').value=profile.title;document.getElementById('profile-content').value=profile.content;document.getElementById('profile-status').textContent=`${profile.status} · V${profile.version}`}
async function load(){item=await api('/api/jobs/'+id);document.querySelector('[name=name]').value=item.name;document.getElementById('score-version').textContent=item.scoreConfigVersion;document.getElementById('state').textContent=item.status==='OPEN'?'关闭':'开放';await loadProfile();const targets=await api(`/api/jobs/${id}/merge-targets`),eligible=targets.filter(x=>x.eligible);document.getElementById('merge-target').innerHTML='<option value="">请选择目标岗位</option>'+targets.map(x=>`<option value="${x.id}" ${x.eligible?'':'disabled'}>${h(x.name)}（${x.resumeCount}份 · ${statusName(x.status)}${x.disabledReason?' · '+h(x.disabledReason):''}）</option>`).join('');document.getElementById('merge-submit').disabled=!eligible.length;document.getElementById('merge-hint').textContent=eligible.length?`当前岗位 ${item.resumeCount} 份简历；共 ${eligible.length} 个岗位可以作为合并目标，灰色岗位后标有不可选原因。`:'当前没有可合并的目标岗位；灰色岗位后标有不可选原因。'}
document.getElementById('job').onsubmit=async e=>{e.preventDefault();const body={name:e.target.elements.name.value,description:item.description,requirement:item.requirement,skillRequirement:item.skillRequirement,minExperienceMonths:item.minExperienceMonths,educationRequirement:item.educationRequirement,rowVersion:item.rowVersion};try{await api(`/api/jobs/${id}/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});show('岗位名称已保存，简历关系和岗位画像关联不受影响。');await load()}catch(x){show(x.message)}};
document.getElementById('profile-save').onclick=async()=>{try{await api(`/api/jobs/${id}/profile/update`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:document.getElementById('profile-title').value,content:document.getElementById('profile-content').value,rowVersion:profile.rowVersion})});showProfile('岗位画像草稿已保存。');await loadProfile()}catch(x){showProfile(x.message)}};
document.getElementById('profile-ai').onclick=async()=>{const b=document.getElementById('profile-ai');b.disabled=true;showProfile('AI正在完善岗位画像草稿，请稍候…');try{const r=await api(`/api/jobs/${id}/profile/ai-draft`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:document.getElementById('profile-title').value,documentType:'JOB_REQUIREMENT',content:document.getElementById('profile-content').value,instruction:document.getElementById('profile-instruction').value})});document.getElementById('profile-content').value=r.content;showProfile('AI草稿已生成，请HR核对后保存。')}catch(x){showProfile(x.message)}finally{b.disabled=false}};
document.getElementById('profile-publish').onclick=async()=>{if(!confirm('确认发布岗位、开放招聘并重建RAG吗？'))return;try{await api(`/api/jobs/${id}/profile/publish`,{method:'POST'});showProfile('岗位已开放；画像索引完成后状态会变为 ACTIVE。');await load();await pollProfile()}catch(x){showProfile(x.message)}};async function pollProfile(){for(let i=0;i<30;i++){await new Promise(r=>setTimeout(r,1000));await loadProfile();if(profile.status!=='INDEXING')break}}
document.getElementById('state').onclick=async()=>{try{await api(`/api/jobs/${id}/${item.status==='OPEN'?'close':'open'}`,{method:'POST'});await load()}catch(x){show(x.message)}};
document.getElementById('merge').onsubmit=async e=>{e.preventDefault();const target=Number(document.getElementById('merge-target').value);const option=document.getElementById('merge-target').selectedOptions[0];if(!target)return;const reason=document.getElementById('merge-reason').value;if(!confirm(`确认把“${item.name}”全部合并到“${option.textContent}”吗？\n当前岗位将被归档，此操作不会删除简历。`))return;try{await api(`/api/jobs/${id}/merge`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({targetJobId:target,reason})});location.href='/jobs'}catch(x){show(x.message)}};
function statusName(v){return v==='OPEN'?'开放':v==='DRAFT'?'草稿':v==='CLOSED'?'已关闭':v}function h(v){const d=document.createElement('div');d.textContent=v;return d.innerHTML}load().catch(x=>show(x.message));
</script>}
